---
export interface Props {
  title: string;
  client: string;
  serviceType: string;
  industry: string;
  slug: string;
  image?: string;
  result?: string;
  /** index 0-2, used to cycle gradient backgrounds */
  index?: number;
}

const { title, client, serviceType, industry, slug, image, result, index = 0 } = Astro.props;
const href = `/portfolio/${slug}/`;

const gradients = ['pa1', 'pa2', 'pa3'];
const gradClass = gradients[index % 3];
---

<a class="proj" href={href}>
  <div class={`proj-art ${gradClass}`}>
    {image ? (
      <img
        src={image}
        alt={`${client} project`}
        loading="lazy"
        style="width:100%;height:100%;object-fit:cover;border-radius:22px"
      />
    ) : (
      <div class="proj-placeholder" aria-hidden="true">
        <span>{client.charAt(0)}</span>
      </div>
    )}
    <span class="tagsample">{serviceType}</span>
  </div>
  <div class="proj-meta">
    <h3>{client}</h3>
    <span class="pill">{industry}</span>
  </div>
  {result && <p>{result}</p>}
</a>

<style>
.proj-placeholder {
  width: 72px; height: 72px;
  border-radius: 50%;
  background: rgba(255,255,255,.25);
  display: grid;
  place-items: center;
}
.proj-placeholder span {
  font-family: var(--font-display);
  font-size: 2rem;
  font-weight: 600;
  color: #fff;
  letter-spacing: -.04em;
}
</style>
