---
export interface Props {
  badge?: string;
  heading: string;
  subheading: string;
  ctaLabel: string;
  ctaHref: string;
  ctaSecondaryLabel?: string;
  ctaSecondaryHref?: string;
  /** 'red' = accent red (default), 'dark' = dark bg, 'surface' = light grey */
  variant?: 'red' | 'dark' | 'surface';
}

const {
  badge,
  heading,
  subheading,
  ctaLabel,
  ctaHref,
  ctaSecondaryLabel,
  ctaSecondaryHref,
  variant = 'red',
} = Astro.props;
---

<div class={`cta-banner cta-banner--${variant}`}>
  <div class="cta-banner-inner">
    <div class="cta-banner-copy">
      {badge && (
        <span class="eyebrow" style="margin-bottom:14px;display:inline-flex">
          <i class={variant === 'red' ? 'sq sq-white' : 'sq'}></i> {badge}
        </span>
      )}
      <h2 class="h2">{heading}</h2>
      <p>{subheading}</p>
    </div>
    <div class="cta-banner-actions">
      <a
        class:list={['btn btn-lg', variant === 'red' ? 'btn-light' : 'btn-red']}
        href={ctaHref}
      >
        {ctaLabel}
        <svg class="ic"><use href="#i-arrow"/></svg>
      </a>
      {ctaSecondaryLabel && ctaSecondaryHref && (
        <a
          class:list={['btn btn-lg', variant === 'red' ? 'btn-ink' : 'btn-ink']}
          href={ctaSecondaryHref}
          style={variant === 'red' ? 'background:rgba(11,10,10,.6);color:#fff' : ''}
        >
          {ctaSecondaryLabel}
          <svg class="ic"><use href="#i-arrow"/></svg>
        </a>
      )}
    </div>
  </div>
</div>

<style>
.cta-banner {
  border-radius: var(--radius);
  padding: clamp(40px, 6vw, 80px) clamp(28px, 5vw, 72px);
  position: relative;
  overflow: hidden;
  isolation: isolate;
}

/* Red variant */
.cta-banner--red {
  background: var(--accent);
  color: #fff;
}
.cta-banner--red::before {
  content: "";
  position: absolute;
  width: 60%; aspect-ratio: 1;
  right: -18%; top: -40%;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,.28), transparent 65%);
  filter: blur(30px);
  z-index: -1;
}
.cta-banner--red p { opacity: .95; }

/* Dark variant */
.cta-banner--dark {
  background: var(--dark);
  color: var(--on-dark);
}
.cta-banner--dark p { color: var(--dark-text); }

/* Surface variant */
.cta-banner--surface {
  background: var(--surface);
  color: var(--fg);
}
.cta-banner--surface p { color: var(--muted-text); }

.cta-banner-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: clamp(28px, 5vw, 64px);
  flex-wrap: wrap;
}
.cta-banner-copy { max-width: 520px; }
.cta-banner-copy .h2 { margin: 14px 0 16px; }
.cta-banner-copy p  { max-width: 48ch; font-size: 15px; }

.cta-banner-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  flex-shrink: 0;
}

/* White dot on red banner */
.sq-white { background: #fff; }
</style>
