---
export interface Props {
  title: string;
  description: string;
  href: string;
  iconId: string;   // SVG sprite id e.g. "i-globe"
  keyword?: string; // SEO keyword label shown in mono
}

const { title, description, href, iconId, keyword } = Astro.props;
---

<a
  class="svc-card"
  href={href}
  aria-label={`Learn about ${title}`}
>
  <div class="svc-card-icon">
    <svg class="ic"><use href={`#${iconId}`}/></svg>
  </div>
  <div class="svc-card-body">
    <h3>{title}</h3>
    <p>{description}</p>
    {keyword && <span class="mono svc-card-kw">{keyword}</span>}
  </div>
  <svg class="ic svc-card-arrow"><use href="#i-arrow"/></svg>
</a>

<style>
.svc-card {
  display: grid;
  grid-template-columns: 52px minmax(0,1fr) 20px;
  align-items: start;
  gap: 18px;
  padding: 24px;
  border-radius: 22px;
  border: 1px solid var(--line);
  background: var(--bg);
  transition: box-shadow .2s, border-color .2s, transform .2s;
  text-decoration: none;
  color: var(--fg);
}
.svc-card:hover {
  border-color: var(--accent);
  box-shadow: 0 8px 32px rgba(217,50,37,.12);
  transform: translateY(-2px);
}
.svc-card-icon {
  width: 52px; height: 52px;
  border-radius: 14px;
  border: 1px solid var(--line);
  display: grid;
  place-items: center;
  flex-shrink: 0;
}
.svc-card-icon .ic { width: 24px; height: 24px; color: var(--accent); }
.svc-card-body h3 {
  font-size: 1.15rem;
  font-weight: 500;
  letter-spacing: -.02em;
  margin-bottom: 6px;
}
.svc-card-body p {
  font-size: 14px;
  color: var(--muted-text);
  line-height: 1.45;
  max-width: 38ch;
}
.svc-card-kw {
  display: inline-block;
  margin-top: 10px;
  color: var(--muted-text);
  font-size: 10px;
}
.svc-card-arrow {
  width: 16px; height: 16px;
  margin-top: 4px;
  color: var(--muted);
  flex-shrink: 0;
  transition: color .2s, transform .2s;
}
.svc-card:hover .svc-card-arrow {
  color: var(--accent);
  transform: translate(2px, -2px);
}
</style>
