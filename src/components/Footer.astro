---
import Logo from './Logo.astro';

const services = [
  { label: 'Web Design',      href: '/services/web-design-kampala/' },
  { label: 'Web Development', href: '/services/web-development-uganda/' },
  { label: 'App Development', href: '/services/app-development-uganda/' },
  { label: 'SEO Services',    href: '/services/seo-services-uganda/' },
  { label: 'Google Ads',      href: '/services/google-ads-uganda/' },
  { label: 'Facebook Ads',    href: '/services/facebook-ads-uganda/' },
];

const company = [
  { label: 'About',     href: '/about/' },
  { label: 'Portfolio', href: '/portfolio/' },
  { label: 'Blog',      href: '/blog/' },
  { label: 'Contact',   href: '/contact/' },
];

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    <div class="foot-grid">

      <!-- Col 1: Brand -->
      <div class="foot-brand">
        <Logo size={36} color="white" />
        <p>Websites, apps, SEO and ads for businesses across Uganda.</p>
        <div class="social">
          <a href="https://facebook.com/ktmagency" aria-label="KTM on Facebook" target="_blank" rel="noopener">
            <svg class="ic" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href="https://instagram.com/ktmagency" aria-label="KTM on Instagram" target="_blank" rel="noopener">
            <svg class="ic" viewBox="0 0 24 24" fill="none"><rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
          </a>
          <a href="https://linkedin.com/company/ktmagency" aria-label="KTM on LinkedIn" target="_blank" rel="noopener">
            <svg class="ic" viewBox="0 0 24 24" fill="none"><rect x="2" y="2" width="20" height="20" rx="4" stroke="currentColor" stroke-width="1.5"/><path d="M8 11v5M8 8v.5M12 16v-5m0 0v-1a2 2 0 0 1 4 0v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </a>
          <a href="https://wa.me/256753784595?text=Hello%20KTM%2C%20I%27d%20like%20a%20quote." aria-label="Chat on WhatsApp" target="_blank" rel="noopener">
            <svg class="ic" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Z"/><path d="M16.4 14.3c-.2-.1-1.4-.7-1.6-.8s-.4-.1-.5.1-.6.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.1 0-.3 0-.4l-.7-1.7c-.2-.4-.4-.4-.5-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4.1c1.7.7 2.4.8 3.2.7a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z"/></svg>
          </a>
        </div>
      </div>

      <!-- Col 2: Services -->
      <div>
        <h4>Services</h4>
        <ul>
          {services.map(s => (
            <li><a href={s.href}>{s.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Company -->
      <div>
        <h4>Company</h4>
        <ul>
          {company.map(c => (
            <li><a href={c.href}>{c.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Contact -->
      <div>
        <h4>Contact</h4>
        <address class="foot-contact">
          <span>Kampala, Uganda</span>
          <a href="https://wa.me/256753784595" target="_blank" rel="noopener">
            WhatsApp: +256 753 784 595
          </a>
          <a href="tel:+256753784595">+256 753 784 595</a>
          <a href="mailto:hello@ktmagency.ug">hello@ktmagency.ug</a>
          <span style="color:var(--dark-text)">We reply within 24 hours</span>
        </address>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="foot-bar">
      <span>&copy; {year} KTM Agency. All rights reserved.</span>
      <nav aria-label="Legal links">
        <a href="/privacy/">Privacy Policy</a>
        <a href="/terms/">Terms of Service</a>
      </nav>
    </div>
  </div>

  <!-- Giant watermark -->
  <div class="giant" aria-hidden="true">KTM</div>
</footer>
