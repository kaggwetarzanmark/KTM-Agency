---
export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  slug: string;
  image?: string;
  readTime?: string;
  variant?: 'default' | 'featured';
}

const {
  title,
  description,
  pubDate,
  category,
  slug,
  image,
  readTime = '5 min read',
  variant = 'default',
} = Astro.props;

// slug comes in as the Astro content slug (no extension)
const href = `/blog/${slug}/`;

const formattedDate = pubDate.toLocaleDateString('en-UG', {
  year: 'numeric', month: 'short', day: 'numeric',
});

const gradientMap: Record<string, string> = {
  'Web Design':        'bc-grad--1',
  'SEO':               'bc-grad--3',
  'Google Ads':        'bc-grad--2',
  'Facebook Ads':      'bc-grad--2',
  'App Development':   'bc-grad--1',
  'Digital Marketing': 'bc-grad--2',
};
const gradClass = gradientMap[category] ?? 'bc-grad--1';

const artText: Record<string, string> = {
  'Web Design':        'WEB',
  'SEO':               '#1',
  'Google Ads':        'ADS',
  'Facebook Ads':      'ADS',
  'App Development':   'APP',
  'Digital Marketing': 'MKT',
};
const artLabel = artText[category] ?? '...';
---

<a class:list={['bc', variant === 'featured' && 'bc--featured']} href={href}>
  <!-- Art / image -->
  {image ? (
    <div class="bc-art">
      <img src={image} alt={title} loading="lazy" />
    </div>
  ) : (
    <div class:list={['bc-art bc-art--gradient', gradClass]} aria-hidden="true">
      {artLabel}
    </div>
  )}

  <!-- Body -->
  <div class="bc-body">
    <div class="bc-meta">
      <span class="bc-cat">{category}</span>
      <span class="bc-sep" aria-hidden="true">·</span>
      <time class="bc-date" datetime={pubDate.toISOString()}>{formattedDate}</time>
      <span class="bc-sep" aria-hidden="true">·</span>
      <span class="bc-read">{readTime}</span>
    </div>

    <h3 class="bc-title">{title}</h3>

    {(variant === 'featured' || description) && (
      <p class="bc-desc">{description}</p>
    )}

    <span class="bc-link">
      Read article
      <svg class="bc-arrow" aria-hidden="true" viewBox="0 0 16 16" fill="none"
           stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
        <path d="M3 13 13 3M5 3h8v8"/>
      </svg>
    </span>
  </div>
</a>

<style>
/* ── CARD SHELL ─────────────────────────────────────────────── */
.bc {
  display: grid;
  grid-template-rows: auto 1fr;
  border-radius: 22px;
  border: 1px solid var(--line);
  background: var(--bg);
  overflow: hidden;
  text-decoration: none;
  color: var(--fg);
  transition: box-shadow .2s, border-color .2s, transform .2s;
}
.bc:hover {
  border-color: var(--accent);
  box-shadow: 0 8px 32px rgba(217,50,37,.1);
  transform: translateY(-2px);
}

/* ── ART ────────────────────────────────────────────────────── */
.bc-art {
  aspect-ratio: 16/9;
  overflow: hidden;
  position: relative;
}
.bc--featured .bc-art {
  aspect-ratio: 16/7;
}

.bc-art img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform .4s ease;
}
.bc:hover .bc-art img { transform: scale(1.03); }

/* Gradient art (no image) */
.bc-art--gradient {
  display: grid;
  place-items: center;
  font-family: var(--font-display);
  font-weight: 800;
  font-size: clamp(2.8rem, 7vw, 5rem);
  letter-spacing: -.06em;
  color: rgba(255,255,255,.9);
}
.bc-grad--1 { background: linear-gradient(140deg, #1d1a19, #5a3a33); }
.bc-grad--2 { background: linear-gradient(140deg, #d93225, #ff9d22); }
.bc-grad--3 { background: linear-gradient(140deg, #2e5b57, #8fc9be); }

/* ── BODY ───────────────────────────────────────────────────── */
.bc-body {
  padding: 22px 24px 24px;
  display: grid;
  gap: 10px;
  align-content: start;
}

/* Meta row */
.bc-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
  font-size: 12px;
  color: var(--muted-text);
}
.bc-cat {
  background: var(--surface);
  color: var(--muted-text);
  padding: 3px 10px;
  border-radius: 999px;
  border: 1px solid var(--line);
  font-size: 11px;
  font-weight: 500;
}
.bc-sep { opacity: .4; }
.bc-read { font-family: var(--font-mono); font-size: 10px; letter-spacing: .04em; text-transform: uppercase; }

/* Title */
.bc-title {
  font-family: var(--font-display);
  font-size: clamp(1.05rem, 1.8vw, 1.25rem);
  font-weight: 600;
  letter-spacing: -.025em;
  line-height: 1.25;
  text-wrap: balance;
}
.bc:hover .bc-title { color: var(--accent); }

/* Description */
.bc-desc {
  font-size: 14px;
  color: var(--muted-text);
  line-height: 1.55;
  max-width: 52ch;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Read more link */
.bc-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  font-weight: 600;
  color: var(--accent);
  margin-top: 4px;
}
.bc-arrow {
  width: 13px;
  height: 13px;
  transition: transform .2s;
}
.bc:hover .bc-arrow { transform: translate(2px, -2px); }
</style>
