---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import FAQ from '../../components/FAQ.astro';
import CTABanner from '../../components/CTABanner.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';

const clusterPosts = [
  {
    title: 'How Much Does a Website Cost in Uganda?',
    slug: 'how-much-does-a-website-cost-in-uganda',
    description: 'A clear breakdown of Uganda web design pricing — from basic business sites to e-commerce stores.',
    readTime: '6 min read',
  },
  {
    title: 'Why Every Business in Uganda Needs a Website',
    slug: 'why-every-business-in-uganda-needs-a-website',
    description: 'Still running your business without a website? Here\'s what you\'re losing every day you don\'t have one.',
    readTime: '5 min read',
  },
  {
    title: 'How to Choose a Web Design Company in Uganda',
    slug: 'how-to-choose-a-web-design-company-in-uganda',
    description: 'Not all web design companies deliver what they promise. Here\'s exactly what to look for and what to avoid.',
    readTime: '6 min read',
  },
];

const features = [
  { icon:'i-mobile', title:'Mobile-first design',   desc:'Built for phones first. 80% of Ugandan users browse on mobile, so every page is optimised for small screens and slow connections.' },
  { icon:'i-trend',  title:'SEO built in',          desc:'Every page is structured for Google from day one: proper headings, meta tags, fast loading and schema markup.' },
  { icon:'i-globe',  title:'Hosting included',      desc:'We set up your domain and hosting on Cloudflare, the fastest CDN in Africa. No technical headaches.' },
  { icon:'i-layers', title:'Easy to manage',        desc:'Update your own content, prices and photos without calling a developer.' },
  { icon:'i-check',  title:'Fast delivery',         desc:'Most business websites are ready to review within 14 days of us receiving your content.' },
  { icon:'i-receipt','title':'Fixed price quotes',  desc:'You get a written quote before we start. The price you approve is the price you pay.' },
];

const process = [
  { n:'01', title:'Discovery call',     desc:'We learn your business, your customers and the pages you need.' },
  { n:'02', title:'Design',             desc:'Wireframes and visual design for your approval before any code is written.' },
  { n:'03', title:'Development',        desc:'We build the site, add your content and wire up forms and WhatsApp.' },
  { n:'04', title:'Launch',             desc:'Testing, domain setup and go-live. We stay available for two weeks after launch.' },
];

const packages = [
  {
    name: 'Basic',
    tagline: 'Perfect for new and small businesses',
    pages: 'Up to 6 pages',
    price: 'UGX 720,000',
    originalPrice: 'UGX 800,000',
    saving: 'Save 10%',
    features: [
      'Mobile-first design',
      'Up to 6 custom pages',
      'Contact form + WhatsApp button',
      'Basic SEO setup',
      'Google Maps embed',
      'Domain and hosting guidance',
      'Online support',
    ],
    highlight: false,
    cta: 'Get started',
  },
  {
    name: 'Standard',
    tagline: 'Most popular for growing businesses',
    pages: 'Up to 10 pages',
    price: 'UGX 1,350,000',
    originalPrice: 'UGX 1,500,000',
    saving: 'Save 10%',
    features: [
      'Everything in Basic',
      'Up to 10 custom pages',
      'Blog setup',
      'Advanced SEO + Google Analytics',
      'Gallery or portfolio section',
      'Social media integration',
      '3 rounds of revisions',
      'Online support',
    ],
    highlight: true,
    cta: 'Get started',
  },
  {
    name: 'Golden',
    tagline: 'For established businesses ready to grow',
    pages: 'Up to 30 pages',
    price: 'UGX 2,250,000',
    originalPrice: 'UGX 2,500,000',
    saving: 'Save 10%',
    features: [
      'Everything in Standard',
      'Up to 30 custom pages',
      'E-commerce ready',
      'MoMo and card payment integration',
      'Custom contact forms',
      'Speed and performance optimisation',
      'Priority support',
    ],
    highlight: false,
    cta: 'Get started',
  },
  {
    name: 'Platinum',
    tagline: 'Full-scale solution for large businesses',
    pages: 'Unlimited pages',
    price: 'UGX 3,600,000',
    originalPrice: 'UGX 4,000,000',
    saving: 'Save 10%',
    features: [
      'Everything in Golden',
      'Unlimited pages',
      'Custom web application features',
      'Staff training session',
      'Dedicated account manager',
      'Priority support for 3 months',
      'Monthly maintenance included',
    ],
    highlight: false,
    cta: 'Get started',
  },
];

const faqs = [
  { question:'How long does a website take to build in Uganda?', answer:'Most business websites take 2 to 4 weeks from the discovery call to launch, depending on how quickly you provide content (text, images, logo). We will give you a specific timeline in your quote.' },
  { question:'How much does a website cost in Uganda?', answer:'A basic 6-page business website starts from UGX 720,000. Larger sites with e-commerce or booking systems cost more. We send a fixed-price quote before starting so there are no surprises.' },
  { question:'Will my website work on mobile phones?', answer:'Yes. Every website we build is mobile-first, meaning it is designed for phones before desktops. We test on the most common Android devices used in Uganda before launch.' },
  { question:'Do you provide hosting and a domain?', answer:'Yes. We handle domain registration and set up hosting on Cloudflare Pages, which is free and extremely fast across Africa. We will explain the annual renewal costs upfront.' },
  { question:'Can I update the website myself?', answer:'Yes. Depending on your package, we can set up a simple content management system so you can edit text, update prices and upload photos without any coding knowledge.' },
];
---

<BaseLayout
  title="Website Design Kampala Uganda | Affordable & Professional | KTM Agency"
  description="KTM Agency builds professional, mobile-first websites for businesses in Kampala and across Uganda. SEO-ready, fast-loading, packages from UGX 720,000. Free quote in 24 hours."
>
  <Hero
    badge="Web Design · Kampala, Uganda"
    heading="Professional Website Design in Kampala, Uganda."
    subheading="KTM builds mobile-first, SEO-ready websites for businesses across Uganda. Fast delivery, fixed pricing, and Google-optimised from day one."
    ctaPrimary={{ label:'Get a Free Quote', href:'/contact/' }}
    ctaSecondary={{ label:'See Our Portfolio', href:'/portfolio/' }}
    variant="light"
  />

  <!-- Features -->
  <section class="section wrap" aria-labelledby="wd-features-heading">
    <div class="sec-head">
      <div>
        <span class="eyebrow"><i class="sq"></i> What's included</span>
        <h2 class="h2" id="wd-features-heading">Every website we build includes</h2>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px">
      {features.map(f => (
        <div style="display:grid;grid-template-columns:40px 1fr;gap:14px;padding:24px;border-radius:22px;border:1px solid var(--line);align-items:start">
          <div style="width:40px;height:40px;border-radius:12px;border:1px solid var(--line);display:grid;place-items:center">
            <svg class="ic" style="width:20px;height:20px;color:var(--accent)"><use href={`#${f.icon}`}/></svg>
          </div>
          <div>
            <h3 style="font-size:1rem;font-weight:500;letter-spacing:-.02em;margin-bottom:6px">{f.title}</h3>
            <p style="font-size:13.5px;color:var(--muted-text);line-height:1.5">{f.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Process -->
  <section class="wrap" style="padding-bottom:clamp(48px,7vw,96px)">
    <div class="sec-head">
      <div>
        <span class="eyebrow"><i class="sq"></i> Our process</span>
        <h2 class="h2">From first call to live site</h2>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1px;background:var(--line);border-radius:22px;overflow:hidden">
      {process.map(step => (
        <div style="background:var(--bg);padding:28px 24px;display:grid;gap:12px">
          <span style="font-family:var(--font-mono);font-size:11px;letter-spacing:.06em;color:var(--accent)">{step.n}</span>
          <h3 style="font-size:1.1rem;font-weight:500;letter-spacing:-.02em">{step.title}</h3>
          <p style="font-size:13.5px;color:var(--muted-text);line-height:1.5">{step.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Packages -->
  <section class="wrap" style="padding-bottom:clamp(48px,7vw,96px)" aria-labelledby="wd-pricing-heading">
    <div class="sec-head">
      <div>
        <span class="eyebrow"><i class="sq"></i> Pricing</span>
        <h2 class="h2" id="wd-pricing-heading">Website packages</h2>
      </div>
      <p class="lead">All prices are fixed. You approve the quote before we start.</p>
    </div>
    <p style="font-family:var(--font-mono);font-size:11px;letter-spacing:.04em;color:var(--accent);text-transform:uppercase;margin-bottom:32px">
      Limited onboarding slots this month. Book early to secure your timeline.
    </p>
    <div class="pricing-grid">
      {packages.map(pkg => (
        <div class:list={['pricing-card', pkg.highlight && 'pricing-card--highlight']}>

          {/* Popular badge */}
          {pkg.highlight && (
            <div class="pricing-popular">Most popular</div>
          )}

          {/* Header */}
          <div class="pricing-header">
            <h3 class="pricing-name">{pkg.name}</h3>
            <p class="pricing-tagline">{pkg.tagline}</p>
          </div>

          {/* Price */}
          <div class="pricing-price-block">
            <div class="pricing-original">{pkg.originalPrice}</div>
            <div class="pricing-amount">{pkg.price}</div>
            <span class="pricing-save">{pkg.saving}</span>
          </div>

          {/* Pages badge */}
          <div class="pricing-pages">{pkg.pages}</div>

          {/* Features */}
          <ul class="pricing-features">
            {pkg.features.map(feat => (
              <li>
                <svg class="ic" style="color:var(--accent);flex-shrink:0;margin-top:2px"><use href="#i-check"/></svg>
                {feat}
              </li>
            ))}
          </ul>

          {/* CTA */}
          <a
            class:list={['btn btn-lg pricing-cta', pkg.highlight ? 'btn-red' : 'btn-ink']}
            href="/contact/"
          >
            {pkg.cta}
            <svg class="ic"><use href="#i-arrow"/></svg>
          </a>

        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <div class="wrap">
    <FAQ items={faqs} heading="Website Design in Uganda: Common Questions" />
  </div>

  <!-- Related cluster posts -->
  <div class="wrap">
    <RelatedPosts heading="Web Design Resources" posts={clusterPosts} />
  </div>

  <!-- CTA -->
  <div class="wrap" style="padding-bottom:clamp(64px,9vw,120px)">
    <CTABanner
      badge="Ready to start?"
      heading="Get a free website quote today"
      subheading="Tell us about your business and we will send a fixed-price quote within 24 hours. No obligation."
      ctaLabel="Request a free quote"
      ctaHref="/contact/"
      variant="red"
    />
  </div>
</BaseLayout>

<style>
/* ── PRICING GRID ─────────────────────────────────────────────── */
.pricing-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 16px;
  align-items: start;
}

.pricing-card {
  position: relative;
  padding: 32px 28px;
  border-radius: 22px;
  border: 1px solid var(--line);
  background: var(--bg);
  display: grid;
  gap: 20px;
  align-content: start;
  transition: box-shadow .2s;
}
.pricing-card:hover {
  box-shadow: 0 8px 32px rgba(0,0,0,.08);
}
.pricing-card--highlight {
  border: 2px solid var(--accent);
  background: var(--surface);
}

/* Popular badge */
.pricing-popular {
  position: absolute;
  top: -12px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--accent);
  color: #fff;
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: .06em;
  text-transform: uppercase;
  padding: 4px 14px;
  border-radius: 999px;
  white-space: nowrap;
}

/* Header */
.pricing-header { display: grid; gap: 4px; }
.pricing-name {
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 600;
  letter-spacing: -.03em;
}
.pricing-tagline {
  font-size: 13.5px;
  color: var(--muted-text);
}

/* Price block */
.pricing-price-block {
  display: flex;
  align-items: baseline;
  gap: 10px;
  flex-wrap: wrap;
  padding-bottom: 20px;
  border-bottom: 1px dashed var(--line);
}
.pricing-original {
  font-size: 14px;
  color: var(--muted);
  text-decoration: line-through;
  text-decoration-color: var(--accent);
}
.pricing-amount {
  font-family: var(--font-display);
  font-size: clamp(1.4rem, 2.5vw, 1.8rem);
  font-weight: 700;
  letter-spacing: -.04em;
  color: var(--fg);
}
.pricing-card--highlight .pricing-amount {
  color: var(--accent);
}
.pricing-save {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: .05em;
  text-transform: uppercase;
  background: rgba(217,50,37,.1);
  color: var(--accent);
  padding: 3px 10px;
  border-radius: 999px;
  align-self: center;
}

/* Pages pill */
.pricing-pages {
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: .04em;
  text-transform: uppercase;
  color: var(--accent);
}

/* Features list */
.pricing-features {
  display: grid;
  gap: 10px;
  list-style: none;
  padding: 0;
  margin: 0;
}
.pricing-features li {
  display: flex;
  gap: 10px;
  align-items: flex-start;
  font-size: 14px;
  line-height: 1.45;
}

/* CTA */
.pricing-cta { justify-self: start; }
</style>
