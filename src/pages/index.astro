        <a class="proj" href="/portfolio/">
          <div class="proj-art pa2">
            <span class="tagsample">Coming soon</span>
          </div>
          <div class="proj-meta"><h3>SwiftBoda</h3><span class="pill">Mobile app</span></div>
          <p>A ride and parcel app for Android, with MoMo payments built in.</p>
        </a>
        <a class="proj" href="/portfolio/">
          <div class="proj-art pa3">
            <span class="tagsample">Coming soon</span>
          </div>
          <div class="proj-meta"><h3>Kololo Homes</h3><span class="pill">Google + Facebook Ads</span></div>
          <p>Lead campaigns that send property buyers straight to WhatsApp.</p>
        </a>
