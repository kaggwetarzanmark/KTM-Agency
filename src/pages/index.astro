            ))}
          </div>

          <!-- Sticky preview panel -->
          <aside class="preview" aria-live="polite" aria-label="Service details">
            <div class="pv-art" id="pvArt">
              <span class="mono" id="pvKw">website design Kampala</span>
              <h3 id="pvTitle">Web Design</h3>
            </div>
            <div class="pv-body">
              <p class="mono">What's included</p>
              <ul id="pvList">
                <li><svg class="ic"><use href="#i-check"/></svg>Mobile-first pages that load fast on mobile data</li>
                <li><svg class="ic"><use href="#i-check"/></svg>Hosting and domain set up for you</li>
                <li><svg class="ic"><use href="#i-check"/></svg>Easy to edit without calling a developer</li>
                <li><svg class="ic"><use href="#i-check"/></svg>Built to be found on Google from day one</li>
              </ul>
              <a class="btn btn-red" id="pvLink" href="/services/web-design-kampala/">
