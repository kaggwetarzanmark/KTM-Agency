  </section>

  <!-- 5. WHY KTM -->
  <section class="section wrap">
    <div class="why">
      <div class="why-intro">
        <span class="eyebrow"><i class="sq"></i> Why KTM</span>
        <h2 class="h2">Why Kampala Businesses Choose KTM</h2>
        <p class="lead">One local team for your website, your search ranking and your ads, so the pieces work together.</p>
        <a class="btn btn-ink btn-lg" href="/contact/" style="justify-self:start">
          Talk to our team
          <svg class="ic"><use href="#i-arrow"/></svg>
        </a>
      </div>
      <div class="why-list">
        {whyItems.map(item => (
          <div class="why-item">
            <div class="why-ic">
              <svg class="ic"><use href={`#${item.icon}`}/></svg>
            </div>
            <div>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. PAIN POINTS -->
  <section class="wrap" aria-labelledby="pain-heading">
    <div class="pain">
      <div class="pain-head">
        <div>
          <span class="eyebrow"><i class="sq"></i> Common problems</span>
          <h2 class="h2" id="pain-heading">Sound Familiar?</h2>
        </div>
        <p class="lead">Tick what applies to you. We'll bring the fixes to your free consultation.</p>
      </div>
      <div class="chips">
        {painPoints.map((point, i) => (
          <label class="chip">
            <input type="checkbox" id={`p${i}`} />
            <span>{point}</span>
