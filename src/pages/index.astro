        ))}
      </div>
      <div class="pain-foot">
        <a class="btn btn-ink btn-lg" href="/contact/">
          Get these fixed
          <svg class="ic"><use href="#i-arrow"/></svg>
        </a>
        <span class="mono" id="painCount" role="status" aria-live="polite">Nothing ticked yet</span>
      </div>
    </div>
  </section>

  <!-- 7. PORTFOLIO TEASER -->
  <section class="section wrap" id="work">
    <div class="sec-head">
      <div>
        <span class="eyebrow"><i class="sq"></i> Our work</span>
        <h2 class="h2">Recent projects</h2>
      </div>
      <a class="link-u" href="/portfolio/">
        View All Projects
