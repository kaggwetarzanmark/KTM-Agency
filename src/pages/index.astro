  <!-- Testimonials -->
  <section class="wrap" aria-labelledby="quotes-heading" style="padding-bottom:clamp(64px,9vw,120px)">
    <div class="sec-head" style="margin-bottom:32px">
      <div>
        <span class="eyebrow"><i class="sq"></i> Kind words</span>
        <h2 class="h2" id="quotes-heading">What clients say</h2>
      </div>
    </div>
    <div class="quotes">
      {testimonials.map(t => (
        <figure class="quote">
          <p>"{t.quote}"</p>
          <figcaption class="mono">{t.author}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- 8. AUDIT CTA -->
  <section class="wrap" id="audit" style="padding-bottom:clamp(64px,9vw,120px)">
    <div class="audit">
      <div>
        <span class="eyebrow"><i class="sq"></i> Free audit</span>
        <h2 class="h2">Get a Free Website and Marketing Audit</h2>
        <p>Send us your website address. We'll check speed, mobile layout, Google visibility and your ads, then tell you what to fix first.</p>
