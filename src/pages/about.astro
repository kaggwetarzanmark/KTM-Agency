---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CTABanner from '../components/CTABanner.astro';

const values = [
  { icon:'i-trend',   title:'Results-driven',  desc:'We measure success by the impact on your business, not the hours we log. Every recommendation we make is tied to a measurable outcome.' },
  { icon:'i-receipt', title:'Transparent',      desc:'No hidden fees, no jargon, no vague reports. You know what we are doing, why we are doing it and what it costs before we start.' },
  { icon:'i-layers',  title:'Partnership',      desc:'We treat every client as a long-term partner. Your success is the only metric that matters to us.' },
  { icon:'i-chat',    title:'Quality',          desc:'We would rather take on fewer projects and deliver exceptional work than rush through a long list of mediocre ones.' },
];

const stats = [
  { value:'60+',  label:'Websites and apps launched' },
  { value:'40+',  label:'Clients served across Uganda' },
  { value:'5+',   label:'Years of experience' },
  { value:'24h',  label:'Maximum reply time' },
];

const team = [
  { name:'Your Name Here',  role:'Founder & Lead Developer',  bio:'Replace this with your real bio. Tell the story of why you started KTM and what you are passionate about building for Ugandan businesses.' },
  { name:'Team Member',     role:'Design Lead',               bio:'Replace with a real team member. Include their background, skills and what they bring to every project.' },
];
---

<BaseLayout
  title="About KTM — Digital Agency Based in Kampala, Uganda"
  description="KTM is a full-service digital agency in Kampala, Uganda. We help businesses grow online through web design, app development, SEO and digital advertising."
>
  <Hero
    badge="About KTM"
    heading="A Kampala Agency Built for Uganda."
    subheading="We exist to make professional digital services accessible to every Ugandan business, from the first website to a full growth strategy."
    ctaPrimary={{ label:'Work with us', href:'/contact/' }}
    ctaSecondary={{ label:'See our work', href:'/portfolio/' }}
    variant="light"
  />

  <!-- Our story -->
  <section class="section wrap">
    <div style="display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:clamp(32px,6vw,96px);align-items:start" class="story-grid">
      <div style="position:sticky;top:calc(env(safe-area-inset-top,0px) + 100px);display:grid;gap:20px">
        <span class="eyebrow"><i class="sq"></i> Our story</span>
        <h2 class="h2">Why we started KTM</h2>
      </div>
      <div style="display:grid;gap:20px">
        <p style="font-size:clamp(1rem,1.6vw,1.15rem);line-height:1.6;color:var(--muted-text)">
          Too many Ugandan businesses are invisible online. They have great products and services,
          but their customers can not find them on Google, their websites do not work on phones,
          and they are spending money on ads that do not convert.
        </p>
        <p style="font-size:15px;line-height:1.7;color:var(--muted-text)">
          KTM was founded to close that gap. We are a Kampala-based team of designers, developers
          and marketers who understand the Ugandan market: the mobile networks, the payment methods,
          the search habits, the WhatsApp culture.
        </p>
        <p style="font-size:15px;line-height:1.7;color:var(--muted-text)">
          We build websites that load fast on mobile data. We run Google Ads targeted at people
          in Uganda actively looking for what you sell. We do SEO that actually moves your ranking
          on Google Search and Maps. And we are available on WhatsApp when you have a question.
        </p>
        <p style="font-size:15px;line-height:1.7;color:var(--muted-text)">
          Everything we do is designed to make your business easier to find, easier to trust and
          easier to buy from.
        </p>
      </div>
    </div>
  </section>

  <!-- Mission -->
  <section class="wrap" style="padding-bottom:clamp(64px,9vw,120px)">
    <div style="background:var(--dark);color:var(--on-dark);border-radius:var(--radius);padding:clamp(48px,7vw,96px);text-align:center;display:grid;gap:20px;justify-items:center">
      <span class="eyebrow" style="color:var(--dark-text)"><i class="sq"></i> Our mission</span>
      <p style="font-family:var(--font-display);font-weight:500;font-size:clamp(1.6rem,3.5vw,2.8rem);line-height:1.1;letter-spacing:-.04em;max-width:18em;text-wrap:balance">
        To make professional digital services accessible to every business in Uganda, regardless of size or budget.
      </p>
    </div>
  </section>

  <!-- Values -->
  <section class="wrap" style="padding-bottom:clamp(64px,9vw,120px)" aria-labelledby="values-heading">
    <div class="sec-head">
      <div>
        <span class="eyebrow"><i class="sq"></i> Our values</span>
        <h2 class="h2" id="values-heading">What we stand for</h2>
      </div>
    </div>
    <div style="display:grid;gap:0">
      {values.map(v => (
        <div class="why-item">
          <div class="why-ic">
            <svg class="ic"><use href={`#${v.icon}`}/></svg>
          </div>
          <div>
            <h3>{v.title}</h3>
            <p>{v.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Stats -->
  <section class="wrap" style="padding-bottom:clamp(64px,9vw,120px)" aria-labelledby="about-stats-heading">
    <div class="stats-head">
      <i class="sq"></i>
      <span class="mono" id="about-stats-heading">By the numbers</span>
    </div>
    <div class="stats">
      {stats.map(s => (
        <div class="stat">
          <b>{s.value}</b>
          <h3>{s.label}</h3>
        </div>
      ))}
    </div>
  </section>

  <!-- Team -->
  <section class="wrap" style="padding-bottom:clamp(64px,9vw,120px)" aria-labelledby="team-heading">
    <div class="sec-head">
      <div>
        <span class="eyebrow"><i class="sq"></i> The team</span>
        <h2 class="h2" id="team-heading">The people behind KTM</h2>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px">
      {team.map(member => (
        <div style="padding:32px;border-radius:22px;border:1px solid var(--line);display:grid;gap:16px;align-content:start">
          <div style="width:72px;height:72px;border-radius:50%;background:var(--surface);border:1px solid var(--line);display:grid;place-items:center">
            <svg class="ic" style="width:32px;height:32px;color:var(--muted)"><use href="#i-chat"/></svg>
          </div>
          <div>
            <h3 style="font-size:1.2rem;font-weight:500;letter-spacing:-.02em">{member.name}</h3>
            <p style="font-family:var(--font-mono);font-size:11px;letter-spacing:.04em;color:var(--accent);text-transform:uppercase;margin-top:4px">{member.role}</p>
          </div>
          <p style="font-size:14px;color:var(--muted-text);line-height:1.6">{member.bio}</p>
        </div>
      ))}
    </div>
  </section>

  <div class="wrap" style="padding-bottom:clamp(64px,9vw,120px)">
    <CTABanner
      badge="Work with us"
      heading="Ready to grow your business online?"
      subheading="Tell us about your business and we will tell you exactly how we can help."
      ctaLabel="Get a free consultation"
      ctaHref="/contact/"
      variant="red"
    />
  </div>
</BaseLayout>

<style>
@media (max-width: 700px) {
  .story-grid { grid-template-columns: minmax(0,1fr) !important; }
  .story-grid > div:first-child { position: static !important; }
}
</style>
